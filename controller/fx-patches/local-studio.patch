+fn executeMcpOnly(ctx: Context, request: tool_contracts.ToolExecutionRequest) !ToolExecutionResult {
+    if (request.live_authority) |authority| {
+        if (!containsName(authority.integrations, request.call.name)) return error.LiveToolAuthorityUnavailable;
+    }
+    const dynamic_tool = switch (tool_mcp_registry.resolve(
+        request.advertised_dynamic_tool_names,
+        mcpRuntimeCapabilities(ctx),
+        request.call.name,
+    )) {
+        .registered => |tool| tool,
+        .not_selected => return semanticFailure(try tool_mcp_runtime.notSelectedOutput(request.result_allocator, request.call.name)),
+        .unsupported => return semanticFailure(try std.fmt.allocPrint(request.result_allocator, "Unsupported tool: {s}", .{request.call.name})),
+    };
+    var progress_bridge = McpProgressBridge{ .ctx = ctx };
+    var call_status: ?tool_mcp_runtime.CallStatus = null;
+    var execution_error: ?anyerror = null;
+    var selected_sink = SelectedDynamicToolSinkState{ .allocator = request.result_allocator };
+    var notice_sink = ContextNoticeSinkState{ .allocator = request.result_allocator };
+    var dispatch_ctx = tool_dispatch.DispatchContext{
+        .allocator = request.result_allocator,
+        .permission_mode = request.permission_mode orelse ctx.permission_mode,
+        .max_tool_result_bytes = request.max_tool_result_bytes,
+        .cancel_flag = ctx.cancel_flag,
+        .tool_call_id = request.call.id,
+        .tool_call_name = request.call.name,
+        .mcp_ctx = ctx.mcp_ctx,
+        .mcp_call_tool = ctx.mcp_call_tool,
+        .mcp_search_tools = ctx.mcp_search_tools,
+        .mcp_tool_schema = ctx.mcp_tool_schema,
+        .mcp_call_feature = ctx.mcp_call_feature,
+        .mcp_access = if (request.live_authority) |authority| rebindMcpAuthorityGeneration(ctx.mcp_access, authority.generation) else ctx.mcp_access,
+        .mcp_input_responder = ctx.mcp_input_responder,
+        .mcp_permission_rules = if ((request.permission_mode orelse ctx.permission_mode) == .yolo) .{} else if (request.live_authority) |authority| authority.rules else ctx.permission_rules,
+        .mcp_call_options = .{
+            .cancel_flag = ctx.cancel_flag,
+            .progress = .{ .context = @ptrCast(&progress_bridge), .callback = emitMcpProgress },
+            .input_responder = ctx.mcp_input_responder,
+            .access = if (request.live_authority) |authority| rebindMcpAuthorityGeneration(ctx.mcp_access, authority.generation) else ctx.mcp_access,
+        },
+        .mcp_call_status_sink = &call_status,
+        .mcp_execution_error_sink = &execution_error,
+    };
+    attachSelectedDynamicToolSink(&dispatch_ctx, &selected_sink);
+    attachContextNoticeSink(&dispatch_ctx, &notice_sink);
+    const registry = tool_dispatch.Registry{ .tools = &.{dynamic_tool} };
+    const dispatched = try tool_dispatch.dispatchAuthorizedToolCall(dispatch_ctx, registry, request.call);
+    if (execution_error) |failure| {
+        dispatched.deinit(request.result_allocator);
+        return failure;
+    }
+    var execution = toolExecutionResultFromDispatch(dispatched);
+    execution.model_output = dispatched.body;
+    if (dispatched.status_detail) |detail| execution.status_detail = detail;
+    if (call_status == .input_required or
+        (execution.status == .failure and tool_mcp_feature_dispatch.isInputRequiredFailure(execution.model_output)))
+    {
+        execution.finish_turn = true;
+        execution.status_detail = "McpInputRequired";
+    }
+    execution.selected_dynamic_tool_name = selected_sink.name;
+    execution.selected_dynamic_tool_schema_json = selected_sink.schema_json;
+    execution.context_notices = notice_sink.notices.items;
+    return execution;
+}
